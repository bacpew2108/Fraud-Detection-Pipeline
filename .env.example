# Copy file này thành .env rồi đổi các mật khẩu: cp .env.example .env

# Oracle: user ứng dụng do container tự tạo trong FREEPDB1
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_USER=fraud_app
DB_PASSWORD=change_me_app_password
# Mật khẩu SYS/SYSTEM, chỉ docker-compose dùng
ORACLE_ADMIN_PASSWORD=change_me_admin_password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_FRAUD_ALERTS=fraud_alerts

REDIS_HOST=localhost
REDIS_PORT=6379

# Múi giờ nghiệp vụ (timestamp giao dịch, dim_time, luật giao dịch ban đêm)
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Số tài khoản trong Redis, producer sinh giao dịch trong cùng dải này
NUM_ACCOUNTS=10000
# Tốc độ producer (giao dịch / giây)
PRODUCER_RATE=500

# Tùy chọn cho Spark (mặc định trong config.py)
# SPARK_MASTER=local[*,4]
# STARTING_OFFSETS=latest
# MAX_OFFSETS_PER_TRIGGER=5000
# CHECKPOINT_DIR=streaming_app/.checkpoint
# SPARK_DRIVER_MEMORY=512m
# Rỗng = micro-batch liên tục (độ trễ thấp nhất); "2 seconds" = ít CPU hơn, trễ hơn
# TRIGGER_INTERVAL=
